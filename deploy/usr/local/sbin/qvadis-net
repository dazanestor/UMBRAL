#!/bin/bash
# Helper de IP del panel Qvadis (systemd-networkd). Lo ejecuta root vía sudo desde el
# manager (usuario pi). Uso:
#   qvadis-net show
#   qvadis-net dhcp
#   qvadis-net static <ip/cidr> <gateway> [dns1] [dns2]
#
# Aplica el cambio y VERIFICA conectividad (ping a la puerta de enlace). Si no hay enlace,
# REVIERTE a la configuración anterior y la reaplica, de modo que una IP mal puesta nunca
# deja la placa sin red. La asociación WiFi la mantiene wpa_supplicant; aquí solo cambia la IP.
set -u
IF=wlan0
NET=/etc/systemd/network/10-wlan0.network
TRIES=15

cur_ip()  { ip -4 -o addr show "$IF" 2>/dev/null | awk '{print $4}' | head -1; }
cur_gw()  { ip -4 route show default dev "$IF" 2>/dev/null | awk '/default/{print $3; exit}'; }
cur_dns() { grep -hoP '^nameserver \K\S+' /run/systemd/resolve/resolv.conf /etc/resolv.conf 2>/dev/null | head -2 | tr '\n' ' '; }

apply() { networkctl reload >/dev/null 2>&1; networkctl reconfigure "$IF" >/dev/null 2>&1; }

verify() {  # 0 = hay puerta de enlace y responde a ping
  local gw i
  for i in $(seq 1 $TRIES); do
    gw=$(cur_gw)
    if [ -n "$gw" ] && ping -c1 -W1 "$gw" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  return 1
}

valid_ip() {
  echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
  local a b c d; IFS=. read -r a b c d <<<"$1"
  for n in "$a" "$b" "$c" "$d"; do [ "$n" -le 255 ] || return 1; done
}

ip2int() { local a b c d; IFS=. read -r a b c d <<<"$1"; echo $(( (10#$a<<24) + (10#$b<<16) + (10#$c<<8) + 10#$d )); }
same_subnet() {  # $1=ip $2=gw $3=prefijo
  local m=$(( (0xFFFFFFFF << (32-10#$3)) & 0xFFFFFFFF ))
  [ $(( $(ip2int "$1") & m )) -eq $(( $(ip2int "$2") & m )) ]
}

write_dhcp() {
  cat > "$NET.new" <<EOF
[Match]
Name=$IF

[Network]
DHCP=yes

[DHCPv4]
RouteMetric=100
EOF
}

# dhcp y static reconfiguran la red con verificacion y revert: una sola a la vez
case "${1:-}" in dhcp|static) exec 9>/run/qvadis-net.lock; flock -n 9 || { echo "ERR busy"; exit 3; };; esac

case "${1:-}" in
  show)
    mode=dhcp; grep -q '^Address=' "$NET" 2>/dev/null && mode=static
    echo "mode=$mode"
    echo "ip=$(cur_ip)"
    echo "gateway=$(cur_gw)"
    echo "dns=$(cur_dns)"
    ;;
  dhcp)
    cp -f "$NET" "$NET.qvbak" 2>/dev/null
    write_dhcp; mv -f "$NET.new" "$NET"
    apply
    if verify; then rm -f "$NET.qvbak"; echo "OK mode=dhcp ip=$(cur_ip)"; exit 0; fi
    [ -f "$NET.qvbak" ] && mv -f "$NET.qvbak" "$NET"; apply; verify
    echo "ERR dhcp-failed reverted"; exit 1
    ;;
  static)
    CIDR="${2:-}"; GW="${3:-}"; DNS1="${4:-}"; DNS2="${5:-}"
    IPADDR="${CIDR%/*}"; PFX="${CIDR#*/}"
    valid_ip "$IPADDR" || { echo "ERR bad-ip"; exit 2; }
    { echo "$PFX" | grep -qE '^[0-9]{1,2}$' && [ "$PFX" -ge 1 ] && [ "$PFX" -le 32 ]; } || { echo "ERR bad-prefix"; exit 2; }
    valid_ip "$GW" || { echo "ERR bad-gw"; exit 2; }
    same_subnet "$IPADDR" "$GW" "$PFX" || { echo "ERR gw-fuera-de-subred"; exit 2; }
    [ -n "$DNS1" ] && { valid_ip "$DNS1" || { echo "ERR bad-dns"; exit 2; }; }
    [ -z "$DNS1" ] && DNS1="$GW"
    cp -f "$NET" "$NET.qvbak" 2>/dev/null
    {
      echo "[Match]"; echo "Name=$IF"; echo
      echo "[Network]"; echo "Address=$CIDR"; echo "Gateway=$GW"; echo "DNS=$DNS1"
      [ -n "$DNS2" ] && valid_ip "$DNS2" && echo "DNS=$DNS2"
    } > "$NET.new"
    mv -f "$NET.new" "$NET"
    apply
    if verify && ip -4 -o addr show "$IF" | grep -q " ${IPADDR}/"; then
      rm -f "$NET.qvbak"; echo "OK mode=static ip=$CIDR gw=$GW"; exit 0
    fi
    [ -f "$NET.qvbak" ] && mv -f "$NET.qvbak" "$NET"; apply; verify
    echo "ERR static-failed reverted"; exit 1
    ;;
  *) echo "ERR usage"; exit 2;;
esac

#!/bin/bash
# Orquestador OTA A/B del videoportero Qvadis (CM3+, tryboot).
# Slots root: A=p3 (PARTUUID <pfx>-03), B=p2 (<pfx>-02). Boot (p1) compartido.
#
# Subcomandos:
#   status      estado de slots/versiones/pending
#   check       compara version local vs remota (GitHub o SRC_DIR)
#   update      OTA de app/config: clona activo->inactivo + overlay deploy/ (sin kernel/boot
#               ni secretos) -> tryboot -> confirm promociona o revierte (rollback perfecto)
#   os-upgrade  sube el SO: clona + 'apt full-upgrade' en el inactivo (chroot) + overlay.
#               Respalda p1 (boot compartido) antes; en fallo restaura p1 y revierte.
#   confirm     (servicio al arrancar) promociona si el slot de prueba esta sano; si no, revierte
#   rollback    vuelve manualmente al otro slot
set -u
CONF=/etc/qvadis-ota.conf
[ -f "$CONF" ] && . "$CONF"
: "${REPO:=}"; : "${BRANCH:=main}"; : "${SRC_DIR:=}"
: "${VERSION_FILE:=/etc/qvadis-version}"
: "${OVERLAY_DIRS:=opt usr etc}"   # NO anadir var: rsync -a copiaria su propietario a /var/lib/qvadis (es de pi)
BOOT=/boot/firmware
MNT=/mnt/ota
LOG=/var/log/qvadis-ota.log
PENDING=$BOOT/ota-pending
INCOMPLETE=/etc/qvadis-slot-incomplete   # existe en un slot mientras se esta preparando: no se puede arrancar
NETOK=$BOOT/ota-net-ok   # existe si la puerta de enlace respondia al ping ANTES de actualizar
P1BAK=/var/lib/qvadis/p1-backup.tgz
# qv_gw_ping_ok (puerta de enlace + ping), compartido con qvadis-net (ver ese fichero)
. /usr/local/sbin/qvadis-apply-verify.sh

# Secretos/estado que el overlay NO debe pisar (el clon ya trae los reales)
OVX=(--exclude=wpa_supplicant/ --exclude=ssh/ --exclude=machine-id --exclude=machine-id.d/ \
     --exclude=asterisk/pjsip.conf --exclude='asterisk/*secret*' \
     --exclude=qvadis/config.json --exclude=qvadis/calls.json --exclude=NetworkManager/system-connections/)
RSX=(--exclude=/tmp/* --exclude=/var/tmp/* --exclude=/var/cache/apt/archives/* \
     '--include=/var/log/**/' '--exclude=/var/log/**' --exclude="$INCOMPLETE"   # logs: solo el arbol de directorios (con su dueño)
     --exclude=/mnt/* --exclude=/media/* --exclude=/lost+found)

log(){ echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; echo "$*"; }
pfx(){ findmnt -no PARTUUID / | sed 's/-[0-9]*$//'; }
cur_puuid(){ findmnt -no PARTUUID /; }
puuid_a(){ echo "$(pfx)-03"; }; puuid_b(){ echo "$(pfx)-02"; }
dev_of(){ case "$1" in *-03) echo /dev/mmcblk0p3;; *-02) echo /dev/mmcblk0p2;; esac; }
cmdfile_of(){ case "$1" in *-03) echo cmdline_a.txt;; *-02) echo cmdline_b.txt;; esac; }
other_of(){ if [ "$1" = "$(puuid_a)" ]; then puuid_b; else puuid_a; fi; }
inactive_puuid(){ other_of "$(cur_puuid)"; }
# $PENDING guarda "puuid ver kind" y cmd_confirm lo lee con 'read' de 3 campos: un VERSION (local,
# remoto o generado) con un espacio/tab suelto lo romperia. Se sanea SIEMPRE en el mismo sitio.
qv_trim(){ printf '%s' "$1" | tr -d '[:space:]'; }
local_version(){ local v; v=$(cat "$VERSION_FILE" 2>/dev/null) || v=0; qv_trim "$v"; }

ensure_cmdfiles(){ local P; P=$(pfx)
  [ -f "$BOOT/cmdline_a.txt" ] || sed "s/root=PARTUUID=[0-9a-f-]*/root=PARTUUID=$P-03/" "$BOOT/cmdline.txt" > "$BOOT/cmdline_a.txt"
  [ -f "$BOOT/cmdline_b.txt" ] || sed "s/root=PARTUUID=[0-9a-f-]*/root=PARTUUID=$P-02/" "$BOOT/cmdline.txt" > "$BOOT/cmdline_b.txt"; }
set_tryboot_to(){ printf 'include config.txt\ncmdline=%s\n' "$(cmdfile_of "$1")" > "$BOOT/tryboot.txt"; }
promote(){ ensure_cmdfiles; cp -f "$BOOT/$(cmdfile_of "$1")" "$BOOT/cmdline.txt"; set_tryboot_to "$(other_of "$1")"; sync; }
# health_ok [exigir_red=0|1]. La red solo se exige si la puerta de enlace respondia al ping antes de la OTA
# (hay routers que no responden: sin esta condicion se revertiria cualquier OTA sana). No se exige DNS/Internet.
# La red se espera contra un plazo real (90 s): sin ruta por defecto cada intento vuelve al instante, y contar
# intentos dejaba muy poco margen para que el WiFi reasocie tras el tryboot. Peor caso total: ~270 s.
health_ok(){
  local i ok=1
  for i in $(seq 1 60); do
    curl -fsS --max-time 2 http://127.0.0.1:8080/api/health >/dev/null 2>&1 && systemctl is-active --quiet qvadis-kiosk \
      && systemctl is-active --quiet asterisk && systemctl is-active --quiet pigpiod && { ok=0; break; }
    sleep 1
  done
  [ "$ok" = 0 ] || return 1
  [ "${1:-0}" = 1 ] || return 0
  # la red aparte, no en cada vuelta del bucle de arriba
  local fin=$((SECONDS + 90))
  while [ "$SECONDS" -lt "$fin" ]; do qv_gw_ping_ok "" 2 && return 0; sleep 1; done
  return 1
}

# Tras un os-upgrade (kernel nuevo al p1 compartido), copia modulos+firmware al OTRO slot
# para que tambien pueda arrancar con el kernel nuevo (mantiene el rollback valido).
sync_modules_to_other(){
  local other dev; other=$(other_of "$(cur_puuid)"); dev=$(dev_of "$other")
  [ -b "$dev" ] || return 0
  mkdir -p "$MNT"; mountpoint -q "$MNT" && umount "$MNT"
  mount "$dev" "$MNT" 2>/dev/null || return 0
  log "sincronizando /usr/lib/modules y firmware al slot $other (rollback valido)"
  rsync -aHX /usr/lib/modules/  "$MNT/usr/lib/modules/"  2>>"$LOG" || true
  rsync -aHX /usr/lib/firmware/ "$MNT/usr/lib/firmware/" 2>>"$LOG" || true
  sync; umount "$MNT" 2>/dev/null || true
}

fetch_src(){ local dest="$1"
  if [ -n "$SRC_DIR" ] && [ -d "$SRC_DIR" ]; then cp -a "$SRC_DIR"/. "$dest"/ && return 0; return 1; fi
  [ -n "$REPO" ] || { log "sin REPO ni SRC_DIR"; return 1; }
  log "descargando $REPO@$BRANCH"
  local tgz; tgz=$(mktemp /tmp/qvadis-ota.XXXXXX) || return 1
  curl -fsSL -A "qvadis-ota" "https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH" -o "$tgz" || { rm -f "$tgz"; return 1; }
  tar -xzf "$tgz" -C "$dest" --strip-components=1; local rc=$?; rm -f "$tgz"; return $rc; }
# Mismo saneado que local_version(): un espacio/tab suelto en el VERSION del repo (local o remoto)
# no debe hacer que cmd_check crea que hay una actualizacion cuando el contenido es el mismo.
remote_version(){ local v
  if [ -n "$SRC_DIR" ] && [ -f "$SRC_DIR/VERSION" ]; then v=$(cat "$SRC_DIR/VERSION")
  else [ -n "$REPO" ] || return 1; v=$(curl -fsSL -A "qvadis-ota" "https://raw.githubusercontent.com/$REPO/$BRANCH/VERSION" 2>/dev/null) || return 1
  fi
  qv_trim "$v"
}

# Prepara el slot inactivo: deja montado en $MNT un clon del activo con el fstab corregido.
prepare_inactive(){ local rc; INACT=$(inactive_puuid); DEV=$(dev_of "$INACT")
  log "preparando slot $INACT ($DEV)"; mkdir -p "$MNT"; mountpoint -q "$MNT" && umount "$MNT"
  mount "$DEV" "$MNT" || { log "mount $DEV fallo"; return 1; }
  mkdir -p "$MNT/etc" && : > "$MNT$INCOMPLETE"
  log "clonando $(cur_puuid) -> $INACT"
  rsync -aHAXx --delete "${RSX[@]}" / "$MNT/" 2>>"$LOG"
  rc=$?   # 24 = ficheros desaparecidos durante la copia (normal en un sistema en marcha)
  if [ "$rc" != 0 ] && [ "$rc" != 24 ]; then log "clon FALLO (rsync rc=$rc); abortando sin tocar el arranque"; umount "$MNT" 2>/dev/null; return 1; fi
  sed -i "/[[:space:]]\/[[:space:]].*ext4/ s/PARTUUID=[0-9a-f-]*/PARTUUID=$INACT/" "$MNT/etc/fstab"; }

# pjsip.conf no se superpone (lleva la clave SIP real): se toma el del repo y se le inyecta la clave actual.
merge_pjsip(){ local src="$1" new cur pw; new="$src/deploy/etc/asterisk/pjsip.conf"; cur="$MNT/etc/asterisk/pjsip.conf"
  [ -f "$new" ] && [ -f "$cur" ] || return 0
  grep -q '^; Qvadis - PJSIP' "$cur" || return 0
  if [ "$(grep -c '^password=' "$new")" != 1 ] || [ "$(grep -c '^password=' "$cur")" != 1 ]; then log "pjsip.conf: no se fusiona (se esperaba exactamente 1 password)"; return 0; fi
  pw=$(grep '^password=' "$cur")
  PW="$pw" awk '/^password=/{print ENVIRON["PW"]; next}{print}' "$new" > "$cur.new" || { rm -f "$cur.new"; return 0; }
  if cmp -s "$cur.new" "$cur"; then rm -f "$cur.new"; return 0; fi
  cp -p "$cur" "$cur.qvbak"; chown --reference="$cur" "$cur.new"; chmod --reference="$cur" "$cur.new"; mv -f "$cur.new" "$cur"; log "pjsip.conf actualizado (clave conservada)"; }

apply_overlay(){ local src="$1" d rc
  for d in $OVERLAY_DIRS; do [ -d "$src/deploy/$d" ] || continue
    rsync -aHAX --chown=root:root "${OVX[@]}" "$src/deploy/$d/" "$MNT/$d/" 2>>"$LOG"; rc=$?
    if [ "$rc" != 0 ] && [ "$rc" != 24 ]; then log "overlay $d FALLO (rsync rc=$rc)"; return 1; fi
  done
  # El arbol de la app es 100% del repo: se borra lo que ya no existe en el (ficheros obsoletos)
  # Mismos excludes que el resto del overlay (OVX), aunque hoy sean inofensivos aqui (no hay
  # secretos bajo opt/qvadis-ui): por si en el futuro algo sensible acabase en ese arbol, este
  # --delete no debe poder borrarlo ni pisarlo.
  if [ -d "$src/deploy/opt/qvadis-ui" ]; then rsync -aHAX --chown=root:root --delete --filter='protect sounds/**' "${OVX[@]}" "$src/deploy/opt/qvadis-ui/" "$MNT/opt/qvadis-ui/" 2>>"$LOG" || { log "overlay opt/qvadis-ui FALLO"; return 1; }; fi
  # pjsip.conf lleva ajustes locales (NAT, certificados, clave): por defecto NO se toca. Fusionarlo es opt-in.
  if [ "${MERGE_PJSIP:-0}" = 1 ]; then merge_pjsip "$src"; fi
  chmod 0755 "$MNT"/usr/local/sbin/qvadis-* 2>>"$LOG" || true     # el tarball puede traer modos sin exec
  chmod 0755 "$MNT"/opt/qvadis-ui/*.sh 2>>"$LOG" || true
  if [ -f "$MNT/etc/sudoers.d/qvadis" ]; then
    chown root:root "$MNT/etc/sudoers.d/qvadis"; chmod 0440 "$MNT/etc/sudoers.d/qvadis"   # el tarball trae 0644
    # un sudoers invalido dejaria la pantalla sin WiFi, reinicio ni OTA desde el panel
    visudo -cf "$MNT/etc/sudoers.d/qvadis" >>"$LOG" 2>&1 || { log "sudoers.d/qvadis no valido"; return 1; }
  fi
  return 0; }

# Arranque de PRUEBA del slot $1: 'confirm' lo promociona si esta sano; si no arranca o no lo esta, se vuelve.
arm_tryboot(){ local slot="$1" ver="$2" kind="$3" i
  rm -f "$NETOK"; for i in 1 2 3; do qv_gw_ping_ok "" 2 && { echo "$slot $ver" > "$NETOK"; break; }; done
  echo "$slot $ver $kind" > "$PENDING"; set_tryboot_to "$slot"; sync
  log "tryboot -> $slot (v$ver, $kind); reiniciando"; sleep 1; reboot "0 tryboot"; }

finalize(){ local ver="$1" kind="$2"
  echo "$ver" > "$MNT$VERSION_FILE"; rm -f "$MNT$INCOMPLETE"; sync; umount "$MNT"
  arm_tryboot "$INACT" "$ver" "$kind"; }

chroot_apt(){ local root="$1" rc
  cp -f /etc/resolv.conf "$root/etc/resolv.conf" 2>/dev/null
  # Cada mount se comprueba (un chroot a medias podria dar un apt "correcto"); el umount es idempotente.
  unmount_chroot() { umount "$root/boot/firmware" "$root/dev/pts" "$root/dev" "$root/sys" "$root/proc" 2>/dev/null; }
  local -a dsts=(proc sys dev dev/pts boot/firmware)
  local -a srcs=(/proc /sys /dev /dev/pts "$BOOT")
  local i; for i in "${!dsts[@]}"; do
    mount --bind "${srcs[$i]}" "$root/${dsts[$i]}" || { log "chroot_apt: fallo mount ${dsts[$i]}"; unmount_chroot; return 1; }
  done
  # CM3+ es ARMv7 (32-bit): solo el kernel v7. Los kernels v6/v8 se purgan aparte (no aplican).
  chroot "$root" /bin/bash -c 'set -e; export DEBIAN_FRONTEND=noninteractive; apt-get update; apt-mark unhold linux-image-rpi-v7 linux-headers-rpi-v7 raspi-firmware 2>/dev/null || true; apt-get -y full-upgrade; apt-get -y autoremove --purge || true; apt-get clean || true' 2>>"$LOG"; rc=$?
  unmount_chroot; return $rc; }

# ¿hay una operacion OTA en marcha? Se mira /proc/locks para no tocar el candado (tomarlo daria "ocupado" a otro)
ota_busy(){ local i; i=$(stat -c %i /run/qvadis-ota.lock 2>/dev/null) && grep -q "FLOCK.*:$i " /proc/locks; }

cmd_status(){ echo "slot_activo=$(cur_puuid)"
  echo "busy=$(ota_busy && echo si || echo no)"
  echo "slot_por_defecto=$(grep -o 'root=PARTUUID=[0-9a-f-]*' "$BOOT/cmdline.txt" | cut -d= -f3)"
  echo "slot_inactivo=$(inactive_puuid)"; echo "version_local=$(local_version)"
  echo "pending=$( [ -f "$PENDING" ] && cat "$PENDING" || echo no )"; }
cmd_check(){ local lv rv; lv=$(local_version); rv=$(remote_version || echo "")
  echo "local=$lv remota=${rv:-?}"
  [ -n "$rv" ] && [ "$rv" != "$lv" ] && { echo "update=si"; return 0; }; echo "update=no"; return 1; }

cmd_update(){ ensure_cmdfiles; local src ver; src=$(mktemp -d)
  fetch_src "$src" || { log "fetch fallo"; rm -rf "$src"; return 1; }
  # Sin espacios NUNCA: $PENDING guarda "puuid ver kind" y cmd_confirm lo lee con 'read' de 3
  # campos; un VERSION del repo con un espacio (o salto de linea) rompería ese parseo.
  ver=$(qv_trim "$(cat "$src/VERSION" 2>/dev/null)"); [ -n "$ver" ] || ver=$(date +%Y%m%d%H%M%S)
  log "=== update app v$ver ==="; prepare_inactive || { rm -rf "$src"; return 1; }
  apply_overlay "$src" || { log "overlay fallo; abortando"; umount "$MNT" 2>/dev/null; rm -rf "$src"; return 1; }
  rm -rf "$src"; finalize "$ver" app; }

cmd_os_upgrade(){ ensure_cmdfiles; local src ver overlay_ok=1; src=$(mktemp -d)
  # A diferencia de cmd_update (que aborta si fetch_src falla), aqui un fallo de red/GitHub al
  # bajar el overlay NO bloquea el 'apt full-upgrade' (el objetivo principal de os-upgrade, que no
  # necesita $src). Pero antes esto se tragaba en silencio y finalize() promocionaba igual, como
  # si la OTA hubiera sido completa: ahora queda registrado y en la marca de qvadis-os-version.
  if ! fetch_src "$src" 2>/dev/null; then
    log "AVISO: no se pudo descargar el overlay de la app (red/GitHub); el SO se actualiza SIN refrescar deploy/"
    overlay_ok=0
  fi
  # VERSION_FILE guarda SIEMPRE la version de la app (es la que compara 'check'): la del repo si se superpone, o
  # la actual si no. La marca de la actualizacion del sistema va aparte, en /etc/qvadis-os-version.
  local osver; osver="os-$(date +%Y%m%d%H%M%S)"; [ "$overlay_ok" = 1 ] || osver="${osver}-sinoverlay"
  ver=""; [ "$overlay_ok" = 1 ] && ver=$(qv_trim "$(cat "$src/VERSION" 2>/dev/null)")
  [ -n "$ver" ] || ver=$(local_version); [ -n "$ver" ] || ver=0
  log "=== os-upgrade $osver (app v$ver) ==="
  mkdir -p "$(dirname "$P1BAK")"; log "respaldando p1 -> $P1BAK"; tar -czf "$P1BAK" -C "$BOOT" . 2>>"$LOG"
  prepare_inactive || { rm -rf "$src"; return 1; }
  log "apt full-upgrade en el slot inactivo (chroot)"
  if ! chroot_apt "$MNT"; then log "apt fallo; restaurando p1 y abortando"; [ -f "$P1BAK" ] && tar -xzf "$P1BAK" -C "$BOOT" 2>>"$LOG" && rm -f "$P1BAK"; sync; umount "$MNT" 2>/dev/null; rm -rf "$src"; return 1; fi
  if [ "$overlay_ok" = 1 ] && [ -d "$src/deploy" ]; then apply_overlay "$src" || { log "overlay fallo; restaurando p1 y abortando"; [ -f "$P1BAK" ] && tar -xzf "$P1BAK" -C "$BOOT" 2>>"$LOG" && rm -f "$P1BAK"; sync; umount "$MNT" 2>/dev/null; rm -rf "$src"; return 1; }; fi
  rm -rf "$src"; echo "$osver" > "$MNT/etc/qvadis-os-version"; finalize "$ver" os; }

cmd_confirm(){ [ -f "$PENDING" ] || exit 0
  local pend_puuid pend_ver pend_kind cur
  read -r pend_puuid pend_ver pend_kind < "$PENDING"; cur=$(cur_puuid)
  if [ "$cur" = "$pend_puuid" ]; then
    log "confirm: en slot de prueba $cur (v$pend_ver, $pend_kind), comprobando salud"
    # solo vale la marca de ESTE arranque (un confirm antiguo no la borra); vacia = escrita por la version anterior
    local net=0 mark; if [ -f "$NETOK" ]; then mark=$(cat "$NETOK"); { [ -z "$mark" ] || [ "$mark" = "$pend_puuid $pend_ver" ]; } && net=1; fi; rm -f "$NETOK"
    if health_ok "$net"; then
      promote "$cur"; echo "$pend_ver" > "$VERSION_FILE"; rm -f "$PENDING"
      if [ "$pend_kind" = os ]; then rm -f "$P1BAK"; sync_modules_to_other; fi
      log "OTA OK: promocionado $cur v$pend_ver ($pend_kind)"
    else
      rm -f "$PENDING"; log "OTA FALLO salud en $cur; revirtiendo"
      [ "$pend_kind" = os ] && [ -f "$P1BAK" ] && { log "restaurando p1"; tar -xzf "$P1BAK" -C "$BOOT" && rm -f "$P1BAK"; sync; }
      sleep 2; reboot
    fi
  else
    rm -f "$PENDING"; log "OTA: no arranco el slot de prueba $pend_puuid; revertido a $cur"
    if [ "$pend_kind" = os ] && [ -f "$P1BAK" ]; then log "restaurando p1 tras fallo de arranque"; tar -xzf "$P1BAK" -C "$BOOT" && rm -f "$P1BAK"; sync; fi
  fi; }

# Volver al otro slot: solo si contiene un sistema completo, y a prueba (como una actualizacion).
cmd_rollback(){ ensure_cmdfiles; local other dev ver="" ok=0
  [ ! -f "$PENDING" ] || { log "rollback: hay una actualizacion pendiente de confirmar"; return 1; }
  other=$(inactive_puuid); dev=$(dev_of "$other"); mkdir -p "$MNT"; mountpoint -q "$MNT" && umount "$MNT"
  mount -o ro "$dev" "$MNT" 2>>"$LOG" || { log "rollback: no puedo montar $dev (¿instalacion sin A/B?)"; return 1; }
  if [ ! -e "$MNT$INCOMPLETE" ] && [ -x "$MNT/usr/lib/systemd/systemd" ] && [ -x "$MNT/usr/local/sbin/qvadis-ota" ] \
     && grep -q "^PARTUUID=$other[[:space:]]" "$MNT/etc/fstab"; then ok=1; ver=$(qv_trim "$(cat "$MNT$VERSION_FILE" 2>/dev/null)"); fi
  umount "$MNT"
  [ "$ok" = 1 ] || { log "rollback: el slot $other no tiene un sistema completo; no se cambia nada"; return 1; }
  log "rollback manual -> $other"; arm_tryboot "$other" "${ver:-0}" app; }

# Una sola operacion a la vez (doble clic en la UI, confirm + update, etc.)
case "${1:-}" in update|os-upgrade|rollback|confirm)
  exec 9>/run/qvadis-ota.lock; flock -n 9 || { echo "ERR busy: otra operacion OTA en curso"; exit 3; };; esac
case "${1:-}" in
  status) cmd_status;; check) cmd_check;; update) cmd_update;;
  os-upgrade) cmd_os_upgrade;; confirm) cmd_confirm;; rollback) cmd_rollback;;
  *) echo "uso: qvadis-ota status|check|update|os-upgrade|confirm|rollback"; exit 2;;
esac

# Fondo igual al de la interfaz (#0d0e12) para que no haya parpadeo al pasar al kiosco
Window.SetBackgroundTopColor(0.051, 0.055, 0.071);
Window.SetBackgroundBottomColor(0.051, 0.055, 0.071);
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

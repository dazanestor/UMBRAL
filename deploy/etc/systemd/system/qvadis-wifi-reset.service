[Unit]
Description=Reparar WiFi rtl8xxxu tras reinicio en caliente (OTA/tryboot)
Wants=wpa_supplicant@wlan0.service
After=wpa_supplicant@wlan0.service systemd-networkd.service

[Service]
Type=oneshot
# Si qvadis-wifi (scan/connect) esta trabajando (tiene el lock), no interviene: reiniciar el supplicant a mitad
# de un cambio de red lo haria fallar y revertir. El lock se mantiene con 'flock' durante TODO el
# script (espera + modprobe + restart), no solo al comprobarlo: si no, qvadis-wifi podia tomar el
# lock a mitad de la espera y chocar con el modprobe/restart igualmente (ver qvadis-wifi-reset.sh).
# Sin RemainAfterExit: así el .timer puede re-ejecutarlo periódicamente (vigilancia en caliente).
ExecStart=/bin/sh -c 'flock -n /run/qvadis-wifi.lock /usr/local/sbin/qvadis-wifi-reset.sh; exit 0'

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/umbral_bg">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/app_name"
        android:textColor="@color/umbral_on_dark"
        android:textSize="22sp" android:textStyle="bold" android:letterSpacing="0.15" />

    <!-- Contenido (una página visible a la vez) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== INICIO ===== -->
        <LinearLayout
            android:id="@+id/page_home"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/camera_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:background="#000000">
                <es.qvadis.app.ui.MjpegView
                    android:id="@+id/camera_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/camera_placeholder"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Sin cámara"
                    android:textColor="#80ECEFF1"
                    android:visibility="gone" />
            </FrameLayout>

            <es.qvadis.app.ui.SlideToOpen
                android:id="@+id/slide_open"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp" android:layout_marginBottom="20dp" />
        </LinearLayout>

        <!-- ===== ACTIVIDAD ===== -->
        <LinearLayout
            android:id="@+id/page_activity"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
                android:text="Eventos recientes"
                android:textColor="#B0ECEFF1" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calls_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:clipToPadding="false" />
            <TextView
                android:id="@+id/activity_empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="24dp"
                android:text="Sin eventos recientes"
                android:textColor="#80ECEFF1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ===== AJUSTES (submenú) ===== -->
        <ScrollView
            android:id="@+id/page_settings"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/acc_info"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:background="@color/umbral_surface"
                    android:textColor="#B0ECEFF1" android:textSize="13sp"
                    android:text="Sin emparejar" />

                <!-- Fila: Emparejar móvil -->
                <LinearLayout
                    android:id="@+id/row_pair"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="18dp" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Emparejar móvil (QR)"
                        android:textColor="@color/umbral_on_dark" android:textSize="16sp" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_chevron" android:contentDescription="@null" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1FFFFFFF" />

                <!-- Fila: Tono -->
                <LinearLayout
                    android:id="@+id/row_tone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tono de llamada"
                            android:textColor="@color/umbral_on_dark" android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tone_label"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Por defecto"
                            android:textColor="#8CA0AB" android:textSize="13sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_chevron" android:contentDescription="@null" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1FFFFFFF" />

                <!-- Ajustes del portero (remotos, con token) -->
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:layout_marginBottom="2dp"
                    android:text="Portero" android:textColor="#8CA0AB" android:textSize="13sp" android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="No molestar" android:textColor="@color/umbral_on_dark" android:textSize="16sp" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/set_dnd" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Volumen del timbre" android:textColor="#B0ECEFF1" android:textSize="14sp" />
                <SeekBar android:id="@+id/set_ringvol"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"
                    android:progressTint="@color/umbral_blue" android:thumbTint="@color/umbral_blue" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Altavoz de la calle" android:textColor="#B0ECEFF1" android:textSize="14sp" />
                <SeekBar android:id="@+id/set_spkstreet"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"
                    android:progressTint="@color/umbral_blue" android:thumbTint="@color/umbral_blue" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Micrófono de la calle" android:textColor="#B0ECEFF1" android:textSize="14sp" />
                <SeekBar android:id="@+id/set_micstreet"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"
                    android:progressTint="@color/umbral_blue" android:thumbTint="@color/umbral_blue" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1FFFFFFF"
                    android:layout_marginTop="16dp" />

                <!-- Fila: Desemparejar -->
                <LinearLayout
                    android:id="@+id/row_unpair"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="18dp" android:clickable="true" android:focusable="true">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Desemparejar este móvil"
                        android:textColor="#E57373" android:textSize="16sp" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_chevron" android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/umbral_surface"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color" />
</LinearLayout>

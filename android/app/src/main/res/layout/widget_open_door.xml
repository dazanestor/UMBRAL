<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Abrir puerta": un toque -> QuickOpenActivity (huella/PIN -> abre). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open_btn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_btn_bg"
    android:padding="12dp">

    <ImageView
        android:layout_width="26dp" android:layout_height="26dp"
        android:src="@drawable/ic_door_open"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_open_door"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp" />
</LinearLayout>
